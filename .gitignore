# Hair Twin monorepo — root ignores. Package-specific ignores live in each
# package (apps/web/.gitignore, workers/ai-worker/.gitignore,
# supabase/local-verify/.gitignore).

# Dependencies (any package)
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment / secrets — never commit real values
.env
.env.local
.env*.local

# Build output / caches
dist/
.next/
out/
coverage/
*.tsbuildinfo

# Python (workers)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Supabase CLI runtime state
supabase/.branches/
supabase/.temp/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?
