# Hair Twin MVP environment
#
# Fast MVP note:
# OpenAI calls are routed through the local Vite dev middleware in vite.config.ts.
# Keep OPENAI_API_KEY without the VITE_ prefix so it is not exposed to browser code.
# For production or salon pilots with customer photos, move this route to a real
# backend/API route with authentication and audit logging.

OPENAI_API_KEY=

# Optional GPT Images settings.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Optional local fallback switch.
VITE_FORCE_MOCK_GENERATION=false
