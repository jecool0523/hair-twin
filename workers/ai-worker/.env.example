# Copy to an untracked local .env only after staging targets are approved.
# This template is intentionally non-runnable and contains no secret values.

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_TIMEOUT_SECONDS=30

HAIR_TWIN_PROVIDER=
HAIR_TWIN_ALLOW_MOCK=false
HAIR_TWIN_POLL_INTERVAL_SECONDS=2
HAIR_TWIN_HEALTH_PORT=8080

HAIR_TWIN_ENABLE_EXTERNAL_AI=false
HAIR_TWIN_OVERSEAS_TRANSFER_CONSENT=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=medium
# `source` is resolved to an explicit, validated GPT Image 2 WxH value.
OPENAI_IMAGE_SIZE=source
OPENAI_IMAGE_TIMEOUT_SECONDS=90
OPENAI_IMAGE_MAX_RETRIES=0
OPENAI_IMAGE_MAX_CALLS_PER_PROCESS=0
OPENAI_IMAGE_MAX_CANDIDATES_PER_JOB=1
OPENAI_IMAGE_MAX_SOURCE_BYTES=10485760
OPENAI_IMAGE_MAX_REQUEST_BYTES=20971520
OPENAI_IMAGE_MAX_RESPONSE_BYTES=33554432

# Use fail_closed until the pinned local models are present in the image.
# local_cv performs CPU-only, in-memory measurements with no third-party transfer.
HAIR_TWIN_CV_PROVIDER=fail_closed
HAIR_TWIN_CV_TIMEOUT_SECONDS=30
HAIR_TWIN_CV_MAX_IMAGE_BYTES=20971520
HAIR_TWIN_CV_MODEL_DIR=/app/models
