# Hair Twin web environment template. Never commit real secrets.

# Local-only defaults: offline development with no external infrastructure.
HAIR_TWIN_PROVIDER=mock
HAIR_TWIN_ALLOW_MOCK=true
HAIR_TWIN_STORE=memory

# Real AI remains closed. Provider/model/quality/size are intentionally blank.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=
OPENAI_IMAGE_SIZE=
OPENAI_IMAGE_MAX_CALLS_PER_PROCESS=0
HAIR_TWIN_ENABLE_EXTERNAL_AI=false
HAIR_TWIN_OVERSEAS_TRANSFER_CONSENT=false

# Retention endpoints fail closed when these server-only values are absent.
RETENTION_SWEEP_TOKEN=
CRON_SECRET=

# Staging Supabase target and region are intentionally unselected.
# Browser-safe values:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never use a NEXT_PUBLIC_ prefix and never log them.
SUPABASE_SECRET_KEY=
MEDIA_TOKEN_SECRET=

# Invite delivery remains unselected. No silent hosted fallback is allowed.
INVITE_EMAIL_PROVIDER=
INVITE_EMAIL_WEBHOOK_URL=
INVITE_EMAIL_WEBHOOK_SECRET=

# Supabase CLI-only variables belong in the local shell or CI secret store,
# never in this runtime file: SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD.
