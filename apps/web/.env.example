# Hair Twin web app — environment template.
# Copy to .env.local for local development. NEVER commit real secrets.
#
# --- Generation provider (server-only). Absent = Mock provider is used. ---
# Which adapter the server uses to process generation jobs: "mock" | "openai"
HAIR_TWIN_PROVIDER=mock
# Only read on the server (route handlers / future Python worker). Never exposed to the browser.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
#
# --- Persistence boundary. "memory" = in-process store (default, dev/tests). ---
# "supabase" is NOT wired to a live project yet — see docs/decisions/ADR-0003.
HAIR_TWIN_STORE=memory
#
# --- Supabase (NOT connected yet; placeholders only). ---
# NEXT_PUBLIC_ vars are the ONLY ones sent to the browser. The service role key
# must never be prefixed NEXT_PUBLIC_ and must never reach client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
