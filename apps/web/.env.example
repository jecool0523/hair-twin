# Hair Twin web app — environment template.
# Copy to .env.local for local development. NEVER commit real secrets.
# .env.local is gitignored; keep it that way.
#
# =============================================================================
# Local defaults: the whole consultation flow runs with NO secrets and NO
# infrastructure. Leave this file as-is to develop offline.
# =============================================================================

# --- Generation provider (server-only). "mock" needs no key. ---
HAIR_TWIN_PROVIDER=mock
HAIR_TWIN_ALLOW_MOCK=true
# Only read on the server / Python worker. Never exposed to the browser.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
HAIR_TWIN_ENABLE_EXTERNAL_AI=false
HAIR_TWIN_OVERSEAS_TRANSFER_CONSENT=false

# --- Persistence. "memory" = in-process store (default, dev/tests). ---
# "supabase" requires the variables in the staging block below.
HAIR_TWIN_STORE=memory

# --- Retention sweep (the real deletion path for expired media). ---
# Required for POST /api/maintenance/retention-sweep. Without it the route
# refuses to run rather than defaulting to open. Generate a long random value
# and store it in your deployment's secret manager.
RETENTION_SWEEP_TOKEN=
CRON_SECRET=

# =============================================================================
# Supabase staging (hair-twin-staging-kr, ap-northeast-2).
# NOT YET CONNECTED — see docs/decisions/ADR-0006. Fill these in only when
# wiring staging, and never commit the values.
#
# Key policy (confirmed infra decision):
#   * Browser  -> publishable key ONLY (sb_publishable_...)
#   * Server / Python worker -> secret key (sb_secret_...), per environment
#   * Do NOT adopt the legacy `service_role` key for new structure.
#   * Anything prefixed NEXT_PUBLIC_ is shipped to the browser. A secret key
#     must NEVER be given a NEXT_PUBLIC_ prefix.
# =============================================================================

# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never NEXT_PUBLIC_, never logged, never in test output:
SUPABASE_SECRET_KEY=
MEDIA_TOKEN_SECRET=

# Production invite delivery: no silent fallback when this is unconfigured.
INVITE_EMAIL_PROVIDER=webhook
INVITE_EMAIL_WEBHOOK_URL=
INVITE_EMAIL_WEBHOOK_SECRET=

# --- Supabase CLI (local shell / CI only; never a runtime app variable) ---
# Needed to link and push migrations to the staging project:
#   SUPABASE_ACCESS_TOKEN   personal access token (supabase login)
#   SUPABASE_DB_PASSWORD    staging database password (supabase db push)
# Set these in your shell or the CI secret store — not in this file.
